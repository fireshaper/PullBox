# Timezone (e.g. America/New_York, Europe/London)
TZ=America/New_York

# Path to your comics library on the host machine
COMICS_PATH=/your/comics/path

# Secret key for session signing — generate with: openssl rand -hex 32
PULLBOX_SECRET_KEY=

# ComicVine API key — https://comicvine.gamespot.com/api/documentation/
PULLBOX_COMICVINE_API_KEY=
