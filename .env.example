# Timezone (e.g. America/New_York, Europe/London)
TZ=America/New_York

# Path to your comics library on the host machine
COMICS_PATH=/your/comics/path

# Secret key for session signing — generate with: openssl rand -hex 32
PULLBOX_SECRET_KEY=

# Metron account login — https://metron.cloud/accounts/register/
# This is your username/password (HTTP Basic auth), NOT an API key.
# Metron is the default primary metadata source.
PULLBOX_METRON_USERNAME=
PULLBOX_METRON_PASSWORD=

# ComicVine API key — https://comicvine.gamespot.com/api/documentation/
# Optional; used as the fallback when Metron is primary.
PULLBOX_COMICVINE_API_KEY=

# Shared token for the read-only companion feed at /api/external/*.
# Leave blank to keep those routes disabled.
PULLBOX_EXTERNAL_API_TOKEN=
